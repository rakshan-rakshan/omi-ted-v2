# deploy/.env — copy to deploy/.env, fill in, and NEVER commit the real file.
# Used by deploy/docker-compose.prod.yml.

# Postgres password for the pgvector container (pick something long & random)
PG_PASSWORD=change_me_to_a_long_random_string

# Translation providers (free models only for translation — see project rules)
OPENROUTER_API_KEY=sk-or-...
SARVAM_API_KEY=
GOOGLE_API_KEY=

# CORS: lock to your Vercel domain. (The Vercel->backend hop is server-side so
# the browser never calls the backend cross-origin, but set this as defense-in-depth.)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional shared secret the Vercel proxy route sends and Caddy/backend checks.
# BACKEND_API_KEY=another_long_random_string
